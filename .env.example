# Required
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional
S3_REGION=
S3_ENDPOINT=
S3_SESSION_TOKEN=

# dark (default) or light
# S3_THEME=dark

# AWS_* aliases also work (S3_* wins if both are set)
# AWS_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_ENDPOINT=
# AWS_SESSION_TOKEN=
